{
  "schemaVersion": "1.0",

  "project": {
    "language": "en",
    "timezone": "Asia/Ho_Chi_Minh"
  },

  "logging": {
    "enabled": true,
    "directory": "logs",
    "level": "Information"
  },

  "knowledge": {
    "root": "knowledge",
    "autoIndex": false,
    "index": "runtime/index/knowledge.json",
    "retrieval": {
      "candidateMinScore": 0.45,
      "confidenceThreshold": 0.62,
      "overfetchFactor": 4
    },
    "grounding": {
      "supportedClaimCoverage": 0.75,
      "partialClaimCoverage": 0.4,
      "minSharedTerms": 2
    }
  },

  "templates": {
    "directory": "templates"
  },

  "runtime": {
    "config": "configs/ai/runtime.json"
  },

  "skills": {
    "directory": "skills",
    "registry": "configs/skills.json"
  },

  "memory": {
    "directory": "memory",
    "retrieval": {
      "maxAgeDays": 90
    }
  },

  "agents": {
    "directory": "agents"
  },

  "prompts": {
    "directory": "prompts"
  }
}
