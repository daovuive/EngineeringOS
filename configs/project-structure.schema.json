{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-os/schema/project-structure.schema.json",
  "title": "Engineering OS Project Structure",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "folders",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "version",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "folders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/folder"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "uniqueItems": true
    },
    "governance": {
      "type": "object",
      "required": [
        "readmeName",
        "protectedRootReadme",
        "ignoredDirectories",
        "allowedRootFiles"
      ],
      "properties": {
        "readmeName": {
          "const": "README.md"
        },
        "protectedRootReadme": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "README.md"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          },
          "additionalProperties": false
        },
        "ignoredDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedRootFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "folder": {
      "type": "object",
      "required": [
        "path",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "template"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
