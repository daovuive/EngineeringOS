{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-os/schema/project-structure.schema.json",
  "title": "Engineering OS Project Structure",
  "type": "object",

  "required": [
    "schemaVersion",
    "project",
    "folders",
    "files"
  ],

  "properties": {
    "schemaVersion": {
      "type": "string"
    },

    "project": {
      "type": "object",
      "required": [
        "name",
        "version",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "folders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/folder"
      },
      "uniqueItems": true
    },

    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "uniqueItems": true
    }
  },

  "$defs": {

    "folder": {

      "type": "object",

      "required": [
        "path",
        "description"
      ],

      "properties": {

        "path": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string"
        }

      },

      "additionalProperties": false

    },

    "file": {

      "type": "object",

      "required": [
        "path",
        "template"
      ],

      "properties": {

        "path": {
          "type": "string",
          "minLength": 1
        },

        "template": {
          "type": "string"
        }

      },

      "additionalProperties": false

    }

  },

  "additionalProperties": false
}